# Application
ENVIRONMENT=dev
PORT=3200
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=30
REQUEST_TIMEOUT_SECONDS=10
MAX_BODY_BYTES=1048576

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=microservice
DB_SSL_MODE=disable

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_ORDERS=orders
RABBITMQ_QUEUE_ORDERS_RETRY=orders.retry
RABBITMQ_QUEUE_ORDERS_DLQ=orders.dlq
RABBITMQ_EXCHANGE_ORDERS=orders.exchange
RABBITMQ_ROUTING_KEY_ORDER_CREATED=order.created
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_MAX_RETRY_DELAY_MS=60000

# Worker
WORKER_PROCESSING_TIMEOUT_SECONDS=30
